#!/bin/sh
# Version-controlled git pre-commit hook. Installed via core.hooksPath (see
# scripts/install-pre-commit.sh), not copied into .git/hooks.
#
# Adapt the checks below to the project's toolchain. Each `run` line is a gate:
# if a command exits non-zero, `set -e` aborts the commit. Keep checks fast —
# this runs on every commit. Use the SKIP env var to bypass in emergencies.
set -eu

# Replace SKIP_PRE_COMMIT with a project-specific name if you prefer, e.g.
# MYPROJ_SKIP_PRE_COMMIT. Bypass once with: SKIP_PRE_COMMIT=1 git commit ...
if [ "${SKIP_PRE_COMMIT:-}" = "1" ]; then
    echo "Skipping pre-commit checks because SKIP_PRE_COMMIT=1"
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

run() {
    echo
    echo "==> $*"
    "$@"
}

# --- Python checks ---
# Drop, swap, or reorder these to match the project:
#   ty check        -> keep ty unless the repo already uses mypy (mypy .) or pyright
#   uv run pytest   -> pytest   or   python -m pytest   (without uv)
run ruff check
run ruff format --check
run ty check
run uv run pytest
